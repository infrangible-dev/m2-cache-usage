{
    "name": "infrangible/m2-cache-usage",
    "description": "Shows how well the full page cache and block cache work: records cache hits and render times per page and block, with admin reports and on-page markers.",
    "type": "magento2-module",
    "version": "3.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Performance",
        "Developer tools",
        "Hyvä",
        "full page cache hit rate report",
        "block cache analysis",
        "cache performance monitoring"
    ],
    "homepage": "https://www.infrangible.dev/modules/cache-usage",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@infrangible.dev",
            "homepage": "https://www.infrangible.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "fewedev/base": "~2.4.1",
        "infrangible/m2-backend-widget": "~4.0.4",
        "infrangible/m2-core": "~5.0.4",
        "infrangible/m2-foundation": "~3.0.1",
        "infrangible/m2-simple-mail": "~2.0.0",
        "infrangible/m2-task": "~3.0.0",
        "magento/framework": "~103.0.6",
        "magento/module-backend": "~102.0.0",
        "magento/module-config": "~101.2.0",
        "magento/module-page-cache": "~100.4.0",
        "psr/log": "~2.0.0||~3.0.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CacheUsage\\": "src"
        }
    }
}
